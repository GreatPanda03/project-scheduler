        </mxCell>
        <mxCell id="PblnSw2yDeAkwNnRdvSF-227" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;" value="&lt;div&gt;-&lt;b&gt; Action Subslot:&lt;/b&gt; a piece of a slot dedicated to acting on tasks for the slot&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- &lt;b&gt;Blocker Slot: &lt;/b&gt;a period of time meant as a break / time out (for lunch, rest, outings, etc.)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- &lt;b&gt;PAR:&lt;/b&gt;&amp;nbsp;&quot;Preparation, Action, Retrospective&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- &lt;b&gt;Preparation Subslot: &lt;/b&gt;a piece of a slot dedicated to preparing for the slot&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;- &lt;b&gt;Project: &lt;/b&gt;a complex goal to work towards&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- &lt;b&gt;Project Details: &lt;/b&gt;a set of information describing a project (name, description, status)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- &lt;b&gt;Resources: &lt;/b&gt;a set of material, websites, apps (etc.) to use for completing a Project&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- &lt;b&gt;Retrospective Subslot:&lt;/b&gt; a piece of a slot dedicated to reviewing the slot&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- &lt;b&gt;Work State Checklist: &lt;/b&gt;a list of pre-schedule activities to ensure optimal working&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- &lt;b&gt;Slot: &lt;/b&gt;a period to work on a particular project&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- &lt;b&gt;Subslot: &lt;/b&gt;a sub-period of a slot to focus on a particular PAR theme&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- &lt;b&gt;Subtask: &lt;/b&gt;any task which is a child of another task&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- &lt;b&gt;Task: &lt;/b&gt;a sub-objective of a Project to progress it&lt;/div&gt;" vertex="1">
          <mxGeometry height="893" width="120" x="630" y="1677" as="geometry" />
        </mxCell>
