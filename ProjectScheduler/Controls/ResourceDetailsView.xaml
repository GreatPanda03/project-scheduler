<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProjectScheduler.Controls.ResourceDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ProjectScheduler.Controls"
    mc:Ignorable="d">

    <Border
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0"
        Padding="28">

        <StackPanel>

            <!-- Placeholder -->
            <controls:PlaceholderView
                x:Name="PlaceholderPanel"
                IconGlyph="&#xE8F1;"
                Header="No resource selected"
                Body="Choose a resource from the list to view its details"/>

            <!-- Resource Details -->
            <ScrollViewer
                x:Name="DetailsPanel"
                Visibility="Collapsed">

                <StackPanel Spacing="16">

                    <TextBlock
                        Text="RESOURCE DETAILS"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- Name -->
                    <TextBox
                        Header="Name"
                        PlaceholderText="No resource name"
                        Text="{x:Bind Resource.Name, Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Left"
                        MinWidth="300"/>

                    <!-- Description -->
                    <TextBox
                        Header="Description"
                        PlaceholderText="No resource description"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Text="{x:Bind Resource.Description, Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock
                        Text="RESOURCE LOCATION"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,12,0,0"/>

                    <Grid ColumnSpacing="24">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Resource Type -->
                        <ComboBox
                            x:Name="ResourceTypeComboBox"
                            Grid.Column="0"
                            Header="Type"
                            MinWidth="125"
                            SelectedItem="{x:Bind Resource.Type, Mode=TwoWay}"/>

                        <!-- Location -->
                        <TextBox
                            Header="Location"
                            Grid.Column="1"
                            PlaceholderText="Enter a file path or URL"
                            Text="{x:Bind Resource.Location, Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"/>
                    </Grid>
                        
                    <!-- Actions -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,12,0,0">

                        <Button Click="OpenButton_Click">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <SymbolIcon Symbol="OpenFile"/>
                                <TextBlock Text="Open Resource"/>

                            </StackPanel>
                        </Button>

                        <Button Click="SaveButton_Click">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <SymbolIcon Symbol="Save"/>
                                <TextBlock Text="Save Changes"/>

                            </StackPanel>
                        </Button>

                        <Button Click="DeleteButton_Click">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <SymbolIcon Symbol="Delete"/>
                                <TextBlock Text="Delete Resource"/>

                            </StackPanel>
                        </Button>

                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </StackPanel>

    </Border>
</UserControl>
