<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProjectScheduler.Controls.ResourceDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>

        <!-- Placeholder -->
        <Border
            x:Name="PlaceholderPanel"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">

                <SymbolIcon Symbol="Library"/>

                <TextBlock
                    Text="Choose a resource from the list to view its details"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"/>

            </StackPanel>
            
        </Border>
        
        <!-- Resource Details -->
        <Border
            x:Name="DetailsPanel"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Padding="28"
            Visibility="Collapsed">

            <ScrollViewer>

                <StackPanel Spacing="16">

                    <TextBlock
                        Text="RESOURCE DETAILS"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- Name -->
                    <TextBox
                        Header="Name"
                        PlaceholderText="No resource name"
                        Text="{Binding Name, Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Description -->
                    <TextBox
                        Header="Description"
                        PlaceholderText="No resource description"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Text="{Binding Description, Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Resource Type -->
                    <ComboBox
                        x:Name="ResourceTypeComboBox"
                        Header="Type"
                        HorizontalAlignment="Stretch"
                        SelectedItem="{Binding Type, Mode=TwoWay}"/>

                    <!-- Location -->
                    <TextBox
                        Header="Location"
                        PlaceholderText="Enter a file path or URL"
                        TextWrapping="Wrap"
                        Text="{Binding Location, Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Actions -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,12,0,0">

                        <Button Click="OpenButton_Click">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <SymbolIcon Symbol="OpenFile"/>
                                <TextBlock Text="Open Resource"/>

                            </StackPanel>
                        </Button>

                        <Button Click="SaveButton_Click">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <SymbolIcon Symbol="Save"/>
                                <TextBlock Text="Save Changes"/>

                            </StackPanel>
                        </Button>

                        <Button Click="DeleteButton_Click">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <SymbolIcon Symbol="Delete"/>
                                <TextBlock Text="Delete Resource"/>

                            </StackPanel>
                        </Button>
                        
                    </StackPanel>
                    
                </StackPanel>
                
            </ScrollViewer>
            
        </Border>

    </Grid>
</UserControl>
