<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProjectScheduler.Controls.ProjectDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ProjectScheduler.Controls"
    mc:Ignorable="d">

    <Border
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0"
        Padding="28">

        <StackPanel>
        
            <!-- Placeholder -->
            <controls:PlaceholderView
                x:Name="PlaceholderPanel"
                IconGlyph="&#xE8B7;"
                Header="No project selected"
                Body="Choose a project from the list to view its details"/>

            <!-- Project Details -->
            <StackPanel 
                x:Name="DetailsPanel"
                Orientation="Vertical"
                Visibility="Collapsed">

                <Grid>
                        
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: PROJECT INFORMATION -->
                    <ScrollViewer Grid.Column="0">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Text="PROJECT DETAILS"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <!-- Name -->
                            <TextBox
                                Header="Name"
                                PlaceholderText="No project name"
                                MinWidth="300"
                                HorizontalAlignment="Left"
                                Text="{x:Bind Project.Name, Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Description -->
                            <TextBox
                                Header="Description"
                                PlaceholderText="No project description"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                Text="{x:Bind Project.Description, Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Project Priority -->
                            <NumberBox
                                x:Name="ProjectPriorityNumberBox"
                                Header="Priority"
                                PlaceholderText="No project priority"
                                HorizontalAlignment="Left"
                                SpinButtonPlacementMode="Inline"
                                ValidationMode="InvalidInputOverwritten"
                                Value="{x:Bind Project.Priority, Mode=TwoWay}"/>

                            <!-- Project Notes -->
                            <TextBox
                                x:Name="ProjectNotesTextBox"
                                Header="Notes"
                                PlaceholderText="No additional notes"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="80"
                                VerticalAlignment="Top"
                                Text="{x:Bind Project.Notes, Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Project Resources -->
                            <controls:ResourceAssignView
                                Title="PROJECT RESOURCES"
                                Target="{x:Bind Project, Mode=OneWay}"
                                Margin="0,8,0,0"/>

                        </StackPanel>

                    </ScrollViewer>

                    <!-- RIGHT COLUMN: TASKS -->
                    <Border
                        Grid.Column="1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        Margin="24,0,0,0"
                        Padding="24,0,0,0">

                        <controls:TaskListView
                            Title="PROJECT TASKS"
                            Target="{x:Bind Project, Mode=OneWay}"
                            ItemsSource="{x:Bind Project.Tasks, Mode=OneWay}"/>

                    </Border>

                </Grid>

                <!-- Save / Delete Project -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,24,0,0">

                    <Button Click="SaveProjectButton_Click">
                        <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                            <SymbolIcon Symbol="Save"/>
                            <TextBlock Text="Save Project"/>

                        </StackPanel>
                    </Button>

                    <Button Click="DeleteProjectButton_Click">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">

                            <SymbolIcon Symbol="Delete"/>
                            <TextBlock Text="Delete Project"/>

                        </StackPanel>
                    </Button>

                </StackPanel>

            </StackPanel>

        </StackPanel>

    </Border>
</UserControl>
