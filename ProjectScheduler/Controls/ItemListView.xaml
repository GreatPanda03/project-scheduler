<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProjectScheduler.Controls.ItemListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Padding="16"
        RowSpacing="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <TextBlock
            Grid.Row="0"
            Text="{x:Bind Title, Mode=OneWay}"
            FontSize="20"
            FontWeight="SemiBold"/>

        <!-- Search -->
        <TextBox
            Grid.Row="1"
            PlaceholderText="{x:Bind SearchPlaceholder, Mode=OneWay}"
            Text="{x:Bind SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            InputScope="Default"/>

        <!-- Add Button -->
        <Button
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            Click="AddButton_Click"
            ToolTipService.ToolTip="{x:Bind AddButtonText, Mode=OneWay}">

            <StackPanel
                Orientation="Horizontal"
                Spacing="8">

                <SymbolIcon Symbol="Add"/>

                <TextBlock
                    Text="{x:Bind AddButtonText, Mode=OneWay}"/>

            </StackPanel>
            
        </Button>
        
        <!-- List -->
        <ListView
            x:Name="ItemsListView"
            Grid.Row="3"
            ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
            SelectedItem="{x:Bind SelectedItem, Mode=TwoWay}"
            ItemTemplate="{x:Bind ItemTemplate, Mode=OneWay}"
            SelectionMode="Single"
            SelectionChanged="ItemsListView_SelectionChanged">
            
        </ListView>
        
    </Grid>
</UserControl>
