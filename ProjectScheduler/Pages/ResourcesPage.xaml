<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectScheduler.Pages.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT PANEL: RESOURCE LIST -->
        <Grid
            Grid.Column="0"
            Padding="16"
            RowSpacing="12">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <TextBox
                x:Name="SearchTextBox"
                Grid.Row="0"
                PlaceholderText="Search resources..."
                TextChanged="SearchTextBox_TextChanged"
                InputScope="Default"/>

            <!-- Add Resource Button -->
            <Button
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                Click="AddResourceButton_Click">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">

                    <FontIcon Glyph="&#xE710;"/>

                    <TextBlock Text="Add Resource"/>

                </StackPanel>
                
            </Button>
            
            <!-- Resource List -->
            <ListView
                x:Name="ResourcesListView"
                Grid.Row="2"
                SelectionMode="Single"
                IsItemClickEnabled="False"
                SelectionChanged="ResourcesListView_SelectionChanged">

                <ListView.ItemTemplate>
                    <DataTemplate>

                        <Grid Padding="6">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                Glyph="{Binding IconGlyph}"
                                FontSize="18"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Name}"
                                FontSize="15"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"/>

                        </Grid>
                        
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>
                
        </Grid>

        
        <!-- RIGHT PANEL: RESOURCE PlACEHOLDER -->
        <Border
            x:Name="ResourcePlaceholderPanel"
            Grid.Column="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="Visible">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">

                <SymbolIcon Symbol="Library"/>

                <TextBlock
                    Text="Select a Resource"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Choose a resource from the list to view its details"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"/>

            </StackPanel>
            
        </Border>

        <!-- RIGHT PANEL: RESOURCE DETAILS -->
        <Border
            x:Name="ResourceDetailsPanel"
            Grid.Column="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Padding="28"
            Visibility="Collapsed">

            <ScrollViewer>
                <StackPanel Spacing="16">

                    <TextBlock
                        Text="RESOURCE DETAILS"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- Resource Name -->
                    <TextBox  
                        x:Name="ResourceNameTextBox"
                        Header="Name"
                        PlaceholderText="No resource name"/>


                    <!-- Resource Description -->
                    <TextBox
                        x:Name="ResourceDescriptionTextBox"
                        Header="Description"
                        PlaceholderText="No resource description"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="100"/>

                    <!-- Resource Type -->
                    <ComboBox
                        x:Name="ResourceTypeComboBox"
                        Header="Type"
                        HorizontalAlignment="Stretch"/>

                    <!-- Resource Directory -->
                    <TextBox
                        x:Name="ResourceDirectoryTextBox"
                        Header="Directory"
                        PlaceholderText="Enter a file path or URL (optional)"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Text="Changes are only applied when you select Save Changes."
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"/>

                    <!-- Action Buttons -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,12,0,0">

                        <Button
                            Content="Open Resource"
                            Click="OpenResourceButton_Click"
                            Style="{ThemeResource DefaultButtonStyle}"/>

                        <Button
                            Content="Save Changes"
                            Click="SaveResourceButton_Click"/>

                        <Button
                            Content="Delete Resource"
                            Click="DeleteResourceButton_Click"
                            Style="{ThemeResource DefaultButtonStyle}"/>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
            
        </Border>
        
    </Grid>
</Page>
