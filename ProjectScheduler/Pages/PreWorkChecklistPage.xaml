<Page
    x:Class="ProjectScheduler.Pages.PreWorkChecklistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="32">

            <StackPanel Spacing="24">

                <!-- Page heading -->
                <StackPanel Spacing="8">
                    <TextBlock
                        Text="Pre-work Checklist"
                        FontSize="32"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Manage the items that appear in your Home page checklist."
                        FontSize="16"
                        Opacity="0.7"
                        TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Add item section -->
                <StackPanel Spacing="12">

                    <TextBlock
                        Text="Add a new item"
                        FontSize="20"
                        FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="NewItemTextBox"
                            PlaceholderText="Enter a checklist item..."
                            Grid.Column="0"
                            KeyDown="NewItemTextBox_KeyDown"/>

                        <Button
                            Content="Add"
                            Grid.Column="1"
                            Click="AddItemButton_Click"/>

                    </Grid>

                </StackPanel>

                <!-- Existing items section -->
                <StackPanel Spacing="12">

                    <TextBlock
                        Text="Existing items"
                        FontSize="20"
                        FontWeight="SemiBold"/>

                    <ListView
                        x:Name="ItemsListView"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        CanDragItems="True"
                        CanReorderItems="True"
                        AllowDrop="True">

                        <ListView.ItemTemplate>
                            <DataTemplate>

                                <Grid
                                    Padding="8"
                                    ColumnSpacing="12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Drag handle -->
                                    <SymbolIcon
                                        Symbol="More"
                                        Width="20"
                                        Height="20"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="0"/>

                                    <!-- Item title -->
                                    <TextBlock
                                        Text="{Binding Title}"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        Grid.Column="1"/>

                                    <!-- Edit button -->
                                    <Button
                                        Content="Edit"
                                        Grid.Column="2"
                                        Click="EditItemButton_Click"/>

                                    <!-- Remove button -->
                                    <Button
                                        Content="Remove"
                                        Grid.Column="3"
                                        Click="RemoveItemButton_Click"/>

                                </Grid>

                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                </StackPanel>

                <!-- Save section -->
                <StackPanel Spacing="12">

                    <TextBlock
                        x:Name="StatusText"
                        Opacity="0.7"
                        TextWrapping="Wrap"/>

                    <Button
                        x:Name="SaveButton"
                        Content="Save Changes"
                        HorizontalAlignment="Right"
                        Click="SaveButton_Click"/>

                </StackPanel>

            </StackPanel>

        </Grid>
    </ScrollViewer>

</Page>
