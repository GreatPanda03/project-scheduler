<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectScheduler.Pages.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ProjectScheduler.Models"
    xmlns:controls="using:ProjectScheduler.Controls"
    mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: PROJECT LIST -->
        <controls:ItemListView
            Grid.Column="0"
            Title="Projects"
            SearchPlaceholder="Search projects..."
            AddButtonText="Add Project"
            ItemsSource="{x:Bind _projectViewModel.FilteredItems, Mode=OneWay}"
            SearchText="{x:Bind _projectViewModel.SearchText, Mode=TwoWay, 
                            UpdateSourceTrigger=PropertyChanged}"
            SelectedItem="{x:Bind _projectViewModel.SelectedItem, Mode=TwoWay}"
            AddRequested="OnAddProjectRequested">

            <controls:ItemListView.ItemTemplate>
                <DataTemplate x:DataType="models:ProjectItem"> 

                    <Grid Padding="6">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <SymbolIcon
                            Grid.Column="0"
                            Symbol="Folder"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"/>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="{x:Bind Name, Mode=OneWay}"
                                FontSize="15"
                                TextTrimming="CharacterEllipsis"/>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <TextBlock
                                    Text="{x:Bind CreatedDateLabel, Mode=OneWay}"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <TextBlock
                                    Text="{x:Bind IncompleteTaskCountLabel, Mode=OneWay}"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            </StackPanel>

                        </StackPanel>
                    </Grid>

                </DataTemplate>
            </controls:ItemListView.ItemTemplate>

        </controls:ItemListView>

        <!-- RIGHT PANEL: PROJECT DETAILS -->
        <controls:ProjectDetailsView
            Grid.Column="1"
            Project="{x:Bind _projectViewModel.SelectedItem, Mode=OneWay}"
            SaveProjectRequested="OnSaveProjectRequested"
            DeleteProjectRequested="OnDeleteProjectRequested"/>

    </Grid>
</Page>
