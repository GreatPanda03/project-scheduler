<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectScheduler.Pages.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT PANEL: PROJECT LIST-->
        <Grid
            Grid.Column="0"
            Padding="16"
            RowSpacing="12">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Search Bar -->
            <TextBox x:ConnectionId='21'
                x:Name="SearchProjectsTextBox"
                Grid.Row="0"
                PlaceholderText="Search projects..."
                                                               
                InputScope="Default"/>
            
            <!-- Add Project Button -->
            <Button x:ConnectionId='22'
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                                              >

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">

                    <FontIcon Glyph="&#xE710;"/>
                    <TextBlock Text="Add Project"/>

                </StackPanel>
                
            </Button>

            <Line HorizontalAlignment="Stretch" Margin="50, 10, 50, 10" Stroke="Black" StrokeThickness="4" />


            <!-- Project List -->
            <ListView x:ConnectionId='23'
                x:Name="ProjectsListView"
                Grid.Row="2"
                SelectionMode="Single"
                                                                    >

                <ListView.ItemTemplate>
                    <DataTemplate>

                        <Grid Padding="6">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <SymbolIcon
                                Grid.Column="0"
                                Symbol="Folder"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Name}"
                                FontSize="15"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"/>
                            
                        </Grid>
                        
                    </DataTemplate>
                </ListView.ItemTemplate>
                
            </ListView>

        </Grid>
        
        <!-- RIGHT PANEL: PROJECT PLACEHOLDER -->
        <Border x:ConnectionId='2'
            x:Name="ProjectPlaceholderPanel"
            Grid.Column="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="Visible">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">

                <SymbolIcon Symbol="Folder"/>

                <TextBlock
                    Text="Select a project"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Choose a project from the list to view its details"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    HorizontalAlignment="Center"/>

            </StackPanel>

        </Border>
        
        <!-- RIGHT PANEL: PROJECT DETAILS -->
        <Border x:ConnectionId='3'
            x:Name="ProjectDetailsPanel"
            Grid.Column="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="Collapsed">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- LEFT COLUMN: PROJECT INFORMATION -->
                <ScrollViewer
                    Grid.Column="0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel
                        Padding="24"
                        Spacing="16">

                        <TextBlock
                            Text="PROJECT DETAILS"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        
                        <!-- Project Name -->
                        <TextBox x:ConnectionId='10'
                            x:Name="ProjectNameTextBox"
                            Header="Name"
                            PlaceholderText="No project name"/>

                        <!-- Project Description -->
                        <TextBox x:ConnectionId='11'
                            x:Name="ProjectDescriptionTextBox"
                            Header="Description"
                            PlaceholderText="No project description"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="80"/>

                        <!-- Project Priority -->
                        <NumberBox x:ConnectionId='12'
                            x:Name="ProjectPriorityNumberBox"
                            Header="Priority"
                            PlaceholderText="No project priority"
                            HorizontalAlignment="Stretch"/>
                        
                        <!-- Project Resources -->
                        <TextBlock
                            Text="RESOURCES"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Margin="0,8,0,0"/>

                        <TextBox x:ConnectionId='13'
                            x:Name="ProjectResourceSearchTextBox"
                            PlaceholderText="Search project resources..."
                                                                                  />

                        <Button x:ConnectionId='14'
                            HorizontalAlignment="Stretch"
                                                           >

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <FontIcon Glyph="&#xE710;"/>
                                <TextBlock Text="Add Resource"/>

                            </StackPanel>
                        </Button>

                        <ListView x:ConnectionId='15'
                            x:Name="ProjectResourcesListView"
                            SelectionMode="Single"
                            MaxHeight="200">

                            <ListView.ItemTemplate>
                                <DataTemplate>

                                    <Grid Padding="6">
                                        
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            Glyph="{Binding IconGlyph}"
                                            FontSize="16"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Name}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"/>

                                    </Grid>

                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">
                            
                            <Button
                                Content="Open Selected Resource"
                                HorizontalAlignment="Stretch"/>

                            <Button x:ConnectionId='19'
                                Content="Remove Selected Resource"
                                                                         
                                HorizontalAlignment="Stretch"/>
                            
                        </StackPanel>

                        <!-- Project Notes -->
                        <TextBox x:ConnectionId='16'
                           x:Name="ProjectNotesTextBox"
                           Header="Notes"
                           PlaceholderText="No additional notes"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="140"
                           VerticalAlignment="Top"/>

                        <!-- Save / Delete Project -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12"
                            Margin="0,12,0,0">
                            
                            <Button x:ConnectionId='17'
                               Content="Save Changes"
                                                              
                               HorizontalAlignment="Stretch"/>

                            <Button x:ConnectionId='18'
                                Content="Delete Project"
                                                                 
                                HorizontalAlignment="Stretch"/>

                        </StackPanel>

                    </StackPanel>
                    
                </ScrollViewer>
                
                <!-- RIGHT COLUMN: TASKS -->
                <Border
                    Grid.Column="1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="20">

                    <Grid RowSpacing="12">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Tasks Heading -->
                        <TextBlock
                            Grid.Row="0"
                            Text="TASKS"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- Add Task Button -->
                        <Button x:ConnectionId='4'
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                                                       >

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <FontIcon Glyph="&#xE710;"/>
                                <TextBlock Text="Add Task"/>

                            </StackPanel>
                            
                        </Button>
                        
                        <!-- Task Filters -->
                        <StackPanel
                            Grid.Row="2"
                            Spacing="10">

                            <ComboBox x:ConnectionId='8'
                                x:Name="TaskCompletionFilterComboBox"
                                Header="Completion"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0">

                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Completed"/>
                                <ComboBoxItem Content="Incomplete"/>

                            </ComboBox>

                            <ComboBox x:ConnectionId='9'
                                x:Name="TaskDateSortComboBox"
                                Header="Sort by Date"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0">

                                <ComboBoxItem Content="Ascending"/>
                                <ComboBoxItem Content="Descending"/>

                            </ComboBox>
                            
                        </StackPanel>
                        
                        <!-- Task List -->
                        <Grid Grid.Row="3">

                            <ListView x:ConnectionId='5'
                                x:Name="TasksListView"
                                SelectionMode="None"
                                VerticalAlignment="Stretch">

                                <ListView.ItemTemplate>
                                    <DataTemplate>

                                        <TextBlock
                                            Text="{Binding}"
                                            TextWrapping="Wrap"
                                            Padding="6">
                                            
                                        </TextBlock>
                                        
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                
                            </ListView>

                            <TextBlock x:ConnectionId='6'
                                x:Name="NoTasksTextBlock"
                                Text="No tasks added yet."
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        </Grid>

                    </Grid>
                    
                </Border>
                
            </Grid>

        </Border>

    </Grid>
</Page>

