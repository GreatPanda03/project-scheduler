<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectScheduler.Pages.SubslotsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ProjectScheduler.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT PANEL: SUBSLOT LIST-->
        <controls:ItemListView x:ConnectionId='2'
            Grid.Column="0"
            Title="Subslots"
            SearchPlaceholder="Search subslots..."
            AddButtonText="Add Subslot"
            ItemsSource="{Binding FilteredItems}"
            SearchText="{Binding SearchText, Mode=TwoWay}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                                 
                                                                >

            <controls:ItemListView.ItemTemplate>

                <DataTemplate>

                    <Grid Padding="6">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Glyph="&#xE917;"
                            FontSize="18"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Name}"
                            FontSize="15"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"/>

                    </Grid>
                    
                </DataTemplate>
                
            </controls:ItemListView.ItemTemplate>
            
        </controls:ItemListView>

        <!-- RIGHT PANEL: SUBSLOT PLACEHOLDER -->
        <Border x:ConnectionId='3'
            x:Name="SubslotPlaceholderPanel"
            Grid.Column="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">

                <SymbolIcon Symbol="ViewAll"/>

                <TextBlock
                    Text="Select a Subslot"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Choose a subslot from the list to view its details"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"/>

            </StackPanel>
            
        </Border>

        <!-- RIGHT PANEL: SUBSLOT DETAILS -->
        <Border x:ConnectionId='4'
            x:Name="SubslotDetailsPanel"
            Grid.Column="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Padding="28"
            Visibility="Collapsed">

            <ScrollViewer>
                <StackPanel Spacing="16">

                    <TextBlock
                        Text="SUBSLOT DETAILS"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- Subslot Name -->
                    <TextBox x:ConnectionId='5'
                        x:Name="SubslotNameTextBox"
                        Header="Name"
                        PlaceholderText="No subslot name"/>

                    <!-- Subslot Description -->
                    <TextBox x:ConnectionId='6'
                        x:Name="SubslotDescriptionTextBox"
                        Header="Description"
                        PlaceholderText="No subslot description"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="100"/>

                    <!-- Subslot Rules -->
                    <TextBlock
                        Text="RULES"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <CheckBox x:ConnectionId='7'
                        x:Name="SubslotLockResourcesCheckBox"
                        Content="Lock Resources"
                        ToolTipService.ToolTip="Disables access to all of the current project's resources"/>

                    <!-- Data Options -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,12,0,0">

                        <Button x:ConnectionId='8'
                            Content="Save Changes"
                                                           />

                        <Button x:ConnectionId='9'
                            Content="Delete Subslot"
                                                             
                            Style="{ThemeResource DefaultButtonStyle}"/>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Border>

    </Grid>
</Page>

