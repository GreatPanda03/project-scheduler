<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectScheduler.Pages.SubslotsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT PANEL: SUBSLOT LIST-->
        <Grid
            Grid.Column="0"
            Padding="16"
            RowSpacing="12">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:ConnectionId='6'
                x:Name="SearchTextBox"
                Grid.Row="0"
                PlaceholderText="Search subslots..."/>

            <Button
                Grid.Row="1"
                HorizontalAlignment="Stretch">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">

                    <FontIcon Glyph="&#xE710;"/>
                    <TextBlock Text="Add Subslot"/>
                    
                </StackPanel>
            </Button>

            <ListView x:ConnectionId='7'
                x:Name="SubslotsListView"
                Grid.Row="2"
                SelectionMode="Single">

                <ListView.ItemTemplate>
                    <DataTemplate>

                        <Grid Padding="6">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                Glyph="&#xE8FD;"
                                FontSize="18"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Name}"
                                FontSize="15"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"/>

                        </Grid>
                        
                    </DataTemplate>
                </ListView.ItemTemplate>
                
            </ListView>

        </Grid>

        <!-- RIGHT PANEL: SUBSLOT PLACEHOLDER -->
        <Border x:ConnectionId='2'
            x:Name="SubslotPlaceholderPanel"
            Grid.Column="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">

                <SymbolIcon Symbol="ViewAll"/>

                <TextBlock
                    Text="Select a Subslot"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Choose a subslot from the list to view its details"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"/>

            </StackPanel>
            
        </Border>

        <!-- RIGHT PANEL: SUBSLOT DETAILS -->
        <Border x:ConnectionId='3'
            x:Name="SubslotDetailsPanel"
            Grid.Column="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Padding="28"
            Visibility="Collapsed">

            <ScrollViewer>
                <StackPanel Spacing="16">

                    <TextBlock
                        Text="SUBSLOT DETAILS"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <TextBox x:ConnectionId='4'
                        x:Name="SubslotNameTextBox"
                        Header="Name"
                        PlaceholderText="No subslot name"/>

                    <TextBox x:ConnectionId='5'
                        x:Name="SubslotDescriptionTextBox"
                        Header="Description"
                        PlaceholderText="No subslot description"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="100"/>


                    <CheckBox>
                        <StackPanel>
                            <TextBlock
                                Text="Lock Resources"/>

                            <SymbolIcon Symbol="Library"
                                        ToolTipService.ToolTip="Disables project resource access during the Subslot"/>
                        </StackPanel>
                    </CheckBox>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,12,0,0">

                        <Button
                            Content="Save Changes"/>

                        <Button
                            Content="Delete Subslot"
                            Style="{ThemeResource DefaultButtonStyle}"/>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Border>

    </Grid>
</Page>

