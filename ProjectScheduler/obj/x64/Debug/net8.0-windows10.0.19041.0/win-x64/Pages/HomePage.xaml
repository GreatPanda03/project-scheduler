<Page
    x:Class="ProjectScheduler.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="32">

            <StackPanel Spacing="24">

                <!-- Welcome message -->
                <StackPanel Spacing="8">
                    <TextBlock
                        Text="Welcome back!"
                        FontSize="32"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Before you get started, please complete your pre-work checklist. These items will help you prepare for your upcoming work session."
                        FontSize="16"
                        TextWrapping="Wrap"
                        Opacity="0.7"/>
                </StackPanel>

                <!-- Pre-work checklist -->
                <StackPanel Spacing="16">

                    <TextBlock
                        Text="Pre-work Checklist"
                        FontSize="22"
                        FontWeight="SemiBold"/>

                    <ItemsControl x:ConnectionId='2'
                        x:Name="HomeChecklistItems">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <CheckBox
                                    Content="{Binding Title}"
                                    IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                    FontSize="16"
                                    Margin="0,4"/>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <Button x:ConnectionId='3'
                        x:Name="StartScheduleButton"
                        Content="Start Schedule"
                                                         
                        IsEnabled="False"
                        HorizontalAlignment="Stretch"
                        Margin="0,24,0,0"
                        Padding="12,10"
                        Width="200"
                        FontSize="16"/>

                </StackPanel>

            </StackPanel>

        </Grid>
    </ScrollViewer>

</Page>

