<Page
    x:Class="ProjectScheduler.Pages.PreWorkChecklistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="32">

            <StackPanel Spacing="24">

                <!-- Page heading -->
                <StackPanel Spacing="8">
                    <TextBlock
                        Text="Pre-work Checklist"
                        FontSize="32"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Manage the items that appear in your Home page checklist."
                        FontSize="16"
                        Opacity="0.7"
                        TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Add item section -->
                <StackPanel>

                    <Grid ColumnSpacing="12">
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:ConnectionId='9'
                            x:Name="NewItemTextBox"
                            PlaceholderText="Enter a checklist item..."
                            Grid.Column="0"
                                                            />

                        <Button x:ConnectionId='10'
                            Grid.Column="1"
                                                       >

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <SymbolIcon Symbol="Add"/>
                                <TextBlock Text="Add"/>
                            </StackPanel>
                        </Button>

                    </Grid>

                </StackPanel>

                <!-- Existing items section -->
                <ListView x:ConnectionId='2'
                    x:Name="ItemsListView"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True">

                    <ListView.ItemTemplate>
                        <DataTemplate>

                            <Grid
                                Padding="8"
                                ColumnSpacing="12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Drag handle -->
                                <SymbolIcon
                                    Symbol="More"
                                    Width="20"
                                    Height="20"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Grid.Column="0"/>

                                <!-- Item title -->
                                <TextBlock
                                    Text="{Binding Title}"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap"
                                    Grid.Column="1"/>

                                <!-- Edit button -->
                                <Button x:ConnectionId='7'
                                    Grid.Column="2"
                                                                >

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="12">

                                        <SymbolIcon Symbol="Edit"/>
                                        <TextBlock Text="Edit"/>
                                    </StackPanel>
                                </Button>

                                <!-- Remove button -->
                                <Button x:ConnectionId='8'
                                    Grid.Column="3"
                                                                  >

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="12">

                                        <SymbolIcon Symbol="Delete"/>
                                        <TextBlock Text="Delete"/>
                                    </StackPanel>
                                </Button>
                                    
                            </Grid>

                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                <!-- Save section -->
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:ConnectionId='3'
                        x:Name="StatusText"
                        Grid.Column="0"
                        Opacity="0.7"
                        TextWrapping="Wrap"/>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="12">

                        <Button x:ConnectionId='4'
                            x:Name="RestoreButton"
                            Content="Restore"
                            HorizontalAlignment="Right"
                                                       />
                        
                        <Button x:ConnectionId='5'
                            x:Name="SaveButton"
                            Content="Save Changes"
                            HorizontalAlignment="Right"
                                                    />

                    </StackPanel>
                    
                </Grid>

            </StackPanel>

        </Grid>
    </ScrollViewer>

</Page>

