<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectScheduler.Pages.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ProjectScheduler.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT PANEL: RESOURCE LIST -->
        <controls:ItemListView x:ConnectionId='2'
            Grid.Column="0"
            Title="Resources"
            SearchPlaceholder="Search resources..."
            AddButtonText="Add Resource"
            ItemsSource="{Binding FilteredItems}"
            SearchText="{Binding SearchText, Mode=TwoWay}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                                  >

            <controls:ItemListView.ItemTemplate>
                <DataTemplate>

                    <Grid Padding="6">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Glyph="{Binding IconGlyph}"
                            FontSize="18"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <StackPanel Grid.Column="1">

                            <TextBlock
                                Text="{Binding Name}"
                                FontSize="15"
                                TextTrimming="CharacterEllipsis"/>

                            <TextBlock
                                Text="{Binding Type}"
                                FontSize="11"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        </StackPanel>

                    </Grid>

                </DataTemplate>
            </controls:ItemListView.ItemTemplate>

        </controls:ItemListView>

        <!-- RIGHT PANEL: RESOURCE DETAILS -->
        <controls:ResourceDetailsView x:ConnectionId='3'
            Grid.Column="1"
            Resource="{Binding SelectedItem, Mode=OneWay}"
                                                    
                                                    
                                                        />

    </Grid>
</Page>

