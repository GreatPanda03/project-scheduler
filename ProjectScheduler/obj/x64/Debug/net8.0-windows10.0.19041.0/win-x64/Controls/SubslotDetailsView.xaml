<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProjectScheduler.Controls.SubslotDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        
        <!-- Placeholder -->
        <Border x:ConnectionId='2'
            x:Name="PlaceholderPanel"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">

                <SymbolIcon Symbol="ViewAll"/>

                <TextBlock
                    Text="Choose a subslot from the list to view its details"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"/>

            </StackPanel>

        </Border>
        
        <!-- Details -->
        <Border x:ConnectionId='3'
            x:Name="DetailsPanel"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Padding="28"
            Visibility="Collapsed">

            <ScrollViewer>
                <StackPanel Spacing="16">

                    <TextBlock
                        Text="SUBSLOT DETAILS"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    
                    <!-- Name -->
                    <TextBox
                        Header="Name"
                        PlaceholderText="No subslot name"
                        Text="{Binding Name, Mode=TwoWay, 
                                UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <!-- Description -->
                    <TextBox
                        Header="Description"
                        PlaceholderText="No description"
                        Text="{Binding Description, Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock
                        Text="SUBSLOT RULES"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,12,0,0"/>

                    <!-- Rules -->
                    <CheckBox
                        Content="Lock Resources"
                        IsChecked="{Binding LockResources, Mode=TwoWay}"
                        ToolTipService.ToolTip="Disables access to all of the current project's resources"/>

                    <!-- Actions -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,12,0,0">

                        <Button x:ConnectionId='4'                         >
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">
                                
                                <SymbolIcon Symbol="Save"/>
                                <TextBlock Text="Save Changes"/>
                                
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='5'                           >
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">
                                
                                <SymbolIcon Symbol="Delete"/>
                                <TextBlock Text="Delete Subslot"/>
                                
                            </StackPanel>
                        </Button>

                    </StackPanel>
                    
                </StackPanel>
            </ScrollViewer>
            
        </Border>

    </Grid>
</UserControl>

