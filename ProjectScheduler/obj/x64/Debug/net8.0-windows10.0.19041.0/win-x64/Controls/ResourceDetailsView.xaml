<?xml version="1.0" encoding="utf-8"?>
<UserControl x:ConnectionId='1'
    x:Class="ProjectScheduler.Controls.ResourceDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ProjectScheduler.Controls"
    mc:Ignorable="d">

    <Border
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0"
        Padding="28">

        <StackPanel>

            <!-- Placeholder -->
            <controls:PlaceholderView x:ConnectionId='2'
                x:Name="PlaceholderPanel"
                IconGlyph="&#xE8F1;"
                Header="No resource selected"
                Body="Choose a resource from the list to view its details"/>

            <!-- Resource Details -->
            <ScrollViewer x:ConnectionId='3'
                x:Name="DetailsPanel"
                Visibility="Collapsed">

                <StackPanel Spacing="16">

                    <TextBlock
                        Text="RESOURCE DETAILS"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- Name -->
                    <TextBox x:ConnectionId='4'
                        Header="Name"
                        PlaceholderText="No resource name"
                                                                 
                                                                     />

                    <!-- Description -->
                    <TextBox x:ConnectionId='5'
                        Header="Description"
                        PlaceholderText="No resource description"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                                                                        
                                                                     />

                    <!-- Resource Type -->
                    <ComboBox x:ConnectionId='6'
                        x:Name="ResourceTypeComboBox"
                        Header="Type"
                        HorizontalAlignment="Stretch"
                                                                          />

                    <!-- Location -->
                    <TextBox x:ConnectionId='7'
                        Header="Location"
                        PlaceholderText="Enter a file path or URL"
                        TextWrapping="Wrap"
                                                                     
                                                                     />

                    <!-- Actions -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,12,0,0">

                        <Button x:ConnectionId='8'                         >
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <SymbolIcon Symbol="OpenFile"/>
                                <TextBlock Text="Open Resource"/>

                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='9'                         >
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <SymbolIcon Symbol="Save"/>
                                <TextBlock Text="Save Changes"/>

                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='10'                           >
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <SymbolIcon Symbol="Delete"/>
                                <TextBlock Text="Delete Resource"/>

                            </StackPanel>
                        </Button>

                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </StackPanel>

    </Border>
</UserControl>

