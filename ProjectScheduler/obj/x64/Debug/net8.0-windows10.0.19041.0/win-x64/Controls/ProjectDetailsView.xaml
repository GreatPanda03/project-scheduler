<?xml version="1.0" encoding="utf-8"?>
<UserControl x:ConnectionId='1'
    x:Class="ProjectScheduler.Controls.ProjectDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ProjectScheduler.Controls"
    mc:Ignorable="d">

    <Border
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0"
        Padding="28">

        <StackPanel>
        
            <!-- Placeholder -->
            <controls:PlaceholderView x:ConnectionId='2'
                x:Name="PlaceholderPanel"
                IconGlyph="&#xE8B7;"
                Header="No project selected"
                Body="Choose a project from the list to view its details"/>

            <!-- Project Details -->
            <StackPanel x:ConnectionId='3' 
                x:Name="DetailsPanel"
                Orientation="Vertical"
                Visibility="Collapsed">

                <Grid>
                        
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: PROJECT INFORMATION -->
                    <ScrollViewer Grid.Column="0">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Text="PROJECT DETAILS"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <!-- Name -->
                            <TextBox x:ConnectionId='7'
                                Header="Name"
                                PlaceholderText="No project name"
                                                                        
                                                                             />

                            <!-- Description -->
                            <TextBox x:ConnectionId='8'
                                Header="Description"
                                PlaceholderText="No project description"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                                                               
                                                                             />

                            <!-- Project Priority -->
                            <NumberBox x:ConnectionId='9'
                                x:Name="ProjectPriorityNumberBox"
                                Header="Priority"
                                PlaceholderText="No project priority"
                                HorizontalAlignment="Stretch"
                                                                              />

                            <!-- Project Resources -->
                            <controls:ResourceAssignView x:ConnectionId='10'
                                Title="PROJECT RESOURCES"
                                                                      
                                                                                        />

                            <!-- Project Notes -->
                            <TextBox x:ConnectionId='11'
                                x:Name="ProjectNotesTextBox"
                                Header="Notes"
                                PlaceholderText="No additional notes"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="140"
                                VerticalAlignment="Top"
                                                                         
                                                                             />

                        </StackPanel>

                    </ScrollViewer>

                    <!-- RIGHT COLUMN: TASKS -->
                    <Border
                        Grid.Column="1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        Margin="24,0,0,0"
                        Padding="24,0,0,0">

                        <controls:TaskListView x:ConnectionId='6'
                            Title="PROJECT TASKS"
                                                                  
                                                                             />

                    </Border>

                </Grid>

                <!-- Save / Delete Project -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,12,0,0">

                    <Button x:ConnectionId='4'
                        Content="Save Changes"
                                                       
                        HorizontalAlignment="Stretch"/>

                    <Button x:ConnectionId='5'
                        Content="Delete Project"
                                                         
                        HorizontalAlignment="Stretch"/>

                </StackPanel>

            </StackPanel>

        </StackPanel>

    </Border>
</UserControl>

