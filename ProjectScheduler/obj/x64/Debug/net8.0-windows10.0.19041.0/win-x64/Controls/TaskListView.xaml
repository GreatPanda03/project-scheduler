<?xml version="1.0" encoding="utf-8"?>
<UserControl x:ConnectionId='1'
    x:Class="ProjectScheduler.Controls.TaskListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ProjectScheduler.Models"
    xmlns:controls="using:ProjectScheduler.Controls"
    mc:Ignorable="d">

    <Grid RowSpacing="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tasks Heading -->
        <Grid ColumnSpacing="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="TASKS"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- Add Task -->
            <Button x:ConnectionId='17'
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                                           >

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">

                    <FontIcon Glyph="&#xE710;"/>
                    <TextBlock Text="Add Task"/>

                </StackPanel>
            </Button>

        </Grid>

        <!-- Task Filters -->
        <Grid 
            Grid.Row="1"
            ColumnSpacing="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <ComboBox x:ConnectionId='15'
                Grid.Column="0"
                Header="Completion Status"
                HorizontalAlignment="Stretch"
                                                                                >

                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Completed"/>
                <ComboBoxItem Content="Incomplete"/>

            </ComboBox>

            <ComboBox x:ConnectionId='16'
                Grid.Column="1"
                x:Name="TaskDateSortComboBox"
                Header="Sort by Date"
                HorizontalAlignment="Stretch"
                                                                        >

                <ComboBoxItem Content="Ascending"/>
                <ComboBoxItem Content="Descending"/>

            </ComboBox>

        </Grid>

        <!-- Task List -->
        <Grid Grid.Row="2">

            <ListView x:ConnectionId='2'
                x:Name="TasksListView"
                                                                           
                                                                           
                SelectionMode="Single"
                VerticalAlignment="Stretch"
                                                                 >

                <ListView.ItemTemplate>
                    <DataTemplate                                  >

                        <Grid x:ConnectionId='4'
                            Padding="6"
                                                                       
                            ColumnSpacing="6">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Expand / Collapse Control -->
                            <Button x:ConnectionId='5'
                                Grid.Column="0"
                                Width="28"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                VerticalAlignment="Center"
                                                                                   
                                                                       >

                                <FontIcon x:ConnectionId='14'
                                                                             
                                    FontSize="12"/>

                            </Button>

                            <!-- Task Checkbox -->
                            <CheckBox x:ConnectionId='6'
                                Grid.Column="1"
                                                                                  
                                VerticalAlignment="Center"
                                MinWidth="0"
                                                                    />
                                <!-- excluding MinWidth makes it insanely long... -->

                            <!-- Task Details -->
                            <StackPanel
                                Grid.Column="3"
                                VerticalAlignment="Center">

                                <TextBlock x:ConnectionId='11'
                                                                          
                                    TextWrapping="Wrap"
                                    FontWeight="SemiBold"/>

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">

                                    <TextBlock x:ConnectionId='12'
                                                                              
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <TextBlock x:ConnectionId='13'
                                                                                    
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                </StackPanel>

                            </StackPanel>

                            <!-- Task Actions -->
                            <StackPanel
                                x:Name="TaskActionsPanel"
                                Grid.Column="4"
                                Orientation="Horizontal"
                                Spacing="5"
                                Visibility="Collapsed">

                                <Button x:ConnectionId='8'
                                                                  
                                    ToolTipService.ToolTip="Add Subtask"
                                    ToolTipService.Placement="Bottom">

                                    <SymbolIcon Symbol="Add"/>
                                </Button>

                                <Button x:ConnectionId='9'
                                                                
                                    ToolTipService.ToolTip="Edit Task"
                                    ToolTipService.Placement="Bottom">

                                    <SymbolIcon Symbol="Edit"/>
                                </Button>

                                <Button x:ConnectionId='10'
                                                                  
                                    ToolTipService.ToolTip="Delete Task"
                                    ToolTipService.Placement="Bottom">

                                    <SymbolIcon Symbol="Delete"/>
                                </Button>

                            </StackPanel>

                        </Grid>

                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

            <!-- Empty Task List Placeholder -->
            <controls:PlaceholderView
                IconGlyph="&#xF0E3;"
                Header="No tasks"
                Body="Create a new task for the project"/>
            
        </Grid>

    </Grid>

</UserControl>

