<?xml version="1.0" encoding="utf-8"?>
<UserControl x:ConnectionId='1'
    x:Class="ProjectScheduler.Controls.ResourceAssignView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectScheduler.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ProjectScheduler.Models"
    xmlns:controls="using:ProjectScheduler.Controls"
    mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:ConnectionId='11'
                Grid.Column="0"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="0,8,0,0"
                                                  />

            <Button x:ConnectionId='12'
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                                               >

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">

                    <SymbolIcon Symbol="Add"/>
                    <TextBlock Text="Add"/>

                </StackPanel>
            </Button>

        </Grid>

        <!-- Assigned Resources -->
        <StackPanel
            Grid.Row="1"
            Margin="0,12,0,0">

            <StackPanel x:ConnectionId='2' 
                x:Name="PlaceholderPanel"
                Background="{ThemeResource SystemFillColorAttentionBackground}"
                Padding="0,0,0,24">
                
                <controls:PlaceholderView
                    Header="No resources"
                    Body="Add resources to this project"
                    IconGlyph="&#xE8F1;"/>
                
            </StackPanel>

            <ListView x:ConnectionId='3'
                x:Name="ListPanel"
                Grid.Row="1"
                                                                      
                Background="{ThemeResource SystemFillColorAttentionBackground}"
                SelectionMode="Single"
                                                                     >

                <ListView.ItemTemplate>
                    <DataTemplate                                 >

                        <Grid x:ConnectionId='5' Padding="6">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon x:ConnectionId='6'
                                Grid.Column="0"
                                                                       
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>

                            <TextBlock x:ConnectionId='7'
                                Grid.Column="1"
                                                                 
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"/>

                            <StackPanel
                                x:Name="ResourceActionsPanel"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="5"
                                Visibility="Collapsed">

                                <Button x:ConnectionId='9'
                                                                    
                                    ToolTipService.ToolTip="Open Resource"
                                    ToolTipService.Placement="Bottom">

                                    <SymbolIcon Symbol="OpenFile"/>
                                </Button>

                                <Button x:ConnectionId='10'
                                                                      
                                    ToolTipService.ToolTip="Remove Resource"
                                    ToolTipService.Placement="Bottom">

                                    <SymbolIcon Symbol="Delete"/>
                                </Button>

                            </StackPanel>

                        </Grid>

                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </StackPanel>

    </Grid>
</UserControl>

